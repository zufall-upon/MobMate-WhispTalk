<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <!-- sherpa-onnx managed wrapper (native DLLs は libs/sherpa-onnx/bin/ に手動配置) -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.1">
      <ExcludeAssets>native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Tts\OnsetAssets\*.wav" LogicalName="MobMate.Onset.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
