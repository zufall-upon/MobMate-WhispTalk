<Window x:Class="MobMate.App.WebHost.SubtitleOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Height="200"
        ResizeMode="CanResize"
        Title="MobMate Subtitle">
    <Grid>
        <!-- 透明ドラッグエリア (全面) -->
        <Rectangle Fill="Transparent" MouseLeftButtonDown="OnDragMove"/>

        <!-- 字幕カードエリア: 下端に横並び -->
        <WrapPanel x:Name="CardsPanel"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   Margin="14,0,14,12"
                   MouseLeftButtonDown="OnDragMove"/>

        <!-- 閉じるボタン (カード右上近く、常時薄く表示) -->
        <Button x:Name="CloseBtn"
                Content="✕"
                Click="CloseBtn_Click"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,8,16"
                Opacity="0.35"
                Width="24" Height="20"
                FontSize="11"
                Foreground="White"
                Background="Transparent"
                BorderBrush="Transparent"
                Cursor="Hand"
                ToolTip="Close subtitle overlay (字幕を閉じる)">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#55FFFFFF"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
