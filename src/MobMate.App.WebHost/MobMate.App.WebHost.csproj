<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <AssemblyName>MobMateWhisp</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MobMate.Core\MobMate.Core.csproj" />
    <Compile Include="..\MobMate.App.Linux\AddonAsrEndpoints.cs" Link="AddonAsrEndpoints.cs" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" GeneratePathProperty="true" />
    <!-- ONNX Runtime C# managed bindings for translation (native DLL excluded; uses existing libs/onnxruntime.dll) -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1">
      <ExcludeAssets>native</ExcludeAssets>
    </PackageReference>
    <!-- SentencePiece BPE tokenizer for m2m100 translation -->
    <!-- Note: translatorcore.dll exports JNI symbols (Java_whisper_TranslatorCore_*) which are not directly callable from C# -->
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>

  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveReferences;ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="$(PkgMicrosoft_Web_WebView2)\lib_manual\net5.0-windows10.0.17763.0\Microsoft.Web.WebView2.Wpf.dll" />
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
